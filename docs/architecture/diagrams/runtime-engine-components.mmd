%% =============================================================================
%% DIAGRAM 2: State Machine - Workflow States
%% =============================================================================

stateDiagram-v2
    [*] --> CREATED: load()

    CREATED --> RUNNING: start()

    RUNNING --> PAUSED: pause()
    RUNNING --> COMPLETED: all phases done
    RUNNING --> FAILED: unrecoverable error

    PAUSED --> RUNNING: resume()
    PAUSED --> CANCELLED: cancel()

    COMPLETED --> [*]
    FAILED --> [*]
    CANCELLED --> [*]

    note right of RUNNING
        Active workflow execution
        - Executing phases
        - Checking gates
        - Invoking agents
    end note

    note right of PAUSED
        Workflow suspended
        - State persisted
        - Can resume
        - Can cancel
    end note


%% =============================================================================
%% DIAGRAM 3: State Machine - Phase States
%% =============================================================================

stateDiagram-v2
    [*] --> PENDING

    PENDING --> ACTIVE: previous phase PASSED

    ACTIVE --> WAITING_GATE: steps complete

    WAITING_GATE --> PASSED: gate criteria met
    WAITING_GATE --> FAILED: gate criteria not met

    FAILED --> ACTIVE: retry (error recovery)

    PASSED --> [*]: next phase

    note right of ACTIVE
        Executing phase steps
        - Running agents
        - Parallel if configured
    end note

    note right of WAITING_GATE
        All steps done
        - Evaluating gate
        - May need approval
    end note


%% =============================================================================
%% DIAGRAM 4: Execution Flow
%% =============================================================================

flowchart TB
    Start([User Request]) --> Load[Load Workflow YAML]
    Load --> Parse[Parse & Validate]
    Parse --> Init[Create Instance]
    Init --> ExecLoop{For Each Phase}

    ExecLoop --> CheckPrereq[Check Prerequisites]
    CheckPrereq --> |Met| ExecSteps[Execute Steps]
    CheckPrereq --> |Not Met| Wait[Wait/Block]
    Wait --> CheckPrereq

    ExecSteps --> Parallel{Parallel Steps?}
    Parallel --> |Yes| ParallelExec[Execute in Parallel]
    Parallel --> |No| SequentialExec[Execute Sequentially]

    ParallelExec --> WaitAll[Wait for All]
    SequentialExec --> WaitAll

    WaitAll --> CheckGate{Check Gate}
    CheckGate --> |PASSED| NextPhase[Move to Next Phase]
    CheckGate --> |FAILED| ErrorRecovery{Recoverable?}
    CheckGate --> |PENDING| WaitApproval[Wait for Approval]

    WaitApproval --> CheckGate

    ErrorRecovery --> |Yes| Retry[Execute Recovery Action]
    ErrorRecovery --> |No| Fail[Workflow FAILED]

    Retry --> ExecSteps

    NextPhase --> ExecLoop
    ExecLoop --> |All Done| Complete[Workflow COMPLETED]

    Complete --> UpdateState[Update State Files]
    Fail --> UpdateState

    UpdateState --> End([End])


%% =============================================================================
%% DIAGRAM 5: Agent Invocation Flow
%% =============================================================================

sequenceDiagram
    participant RE as Runtime Engine
    participant AI as Agent Invoker
    participant ORCH as ORCHESTRATOR
    participant Task as Task Tool
    participant Agent as Target Agent

    RE->>AI: invoke(agent, step, context)
    AI->>AI: Build prompt from step definition
    AI->>AI: Gather context references

    AI->>ORCH: Return Task call structure
    Note over AI,ORCH: Engine generates Task call<br/>ORCHESTRATOR executes it

    ORCH->>Task: Execute Task tool
    Task->>Agent: Load agent definition<br/>Execute with prompt

    Agent->>Agent: Process task
    Agent->>Agent: Generate deliverables

    Agent-->>Task: Return result
    Task-->>ORCH: Agent response
    ORCH-->>AI: Execution result

    AI->>RE: InvocationResult
    Note over RE: status, summary,<br/>deliverables, metrics


%% =============================================================================
%% DIAGRAM 6: Gate Evaluation Flow
%% =============================================================================

flowchart TB
    subgraph Gate["Gate: QUALITY_GATE"]
        Criteria1["Criterion: All tests pass"]
        Criteria2["Criterion: Coverage >= 80%"]
        Criteria3["Criterion: No vulnerabilities"]
    end

    GC[Gate Checker] --> Gate

    Gate --> Eval1[Evaluate: tests_pass]
    Gate --> Eval2[Evaluate: coverage]
    Gate --> Eval3[Evaluate: security_scan]

    Eval1 --> |Run pytest| Result1{Exit code 0?}
    Eval2 --> |Parse report| Result2{>= 80%?}
    Eval3 --> |Run scanner| Result3{Clean?}

    Result1 --> |Yes| Pass1[PASSED]
    Result1 --> |No| Fail1[FAILED]
    Result2 --> |Yes| Pass2[PASSED]
    Result2 --> |No| Fail2[FAILED]
    Result3 --> |Yes| Pass3[PASSED]
    Result3 --> |No| Fail3[FAILED]

    Pass1 --> Aggregate
    Fail1 --> Aggregate
    Pass2 --> Aggregate
    Fail2 --> Aggregate
    Pass3 --> Aggregate
    Fail3 --> Aggregate

    Aggregate{All Passed?}
    Aggregate --> |Yes| GatePassed[Gate PASSED]
    Aggregate --> |No| GateFailed[Gate FAILED]


